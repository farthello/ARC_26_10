<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.0">
  <bpmn:collaboration id="Collaboration_Workflow">
    <bpmn:participant id="Participant_Workflow" name="DAYLIGHT REVIEW" processRef="Process_Workflow" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Workflow" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_Workflow">
      <bpmn:lane id="Lane_Coordinator" name="BIM COORDINATOR">
        <bpmn:flowNodeRef>Task_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Changes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_W</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Analyst" name="BIM ANALYST">
        <bpmn:flowNodeRef>Gateway_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Calc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RankCompare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExportW</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReturnIssues</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Architect" name="ARCHITECT">
        <bpmn:flowNodeRef>StartEvent_W</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Provide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CorrectData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssessChanges</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_W" name="Start process">
      <bpmn:outgoing>Flow_w1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Provide" name="Provide IFC, report claim and confirm room uses and assumptions">
      <bpmn:incoming>Flow_w1</bpmn:incoming>
      <bpmn:outgoing>Flow_w2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CorrectData" name="Correct model data">
      <bpmn:incoming>Flow_w9</bpmn:incoming>
      <bpmn:outgoing>Flow_w10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AssessChanges" name="Assess changes, update IFC model">
      <bpmn:incoming>Flow_w16</bpmn:incoming>
      <bpmn:outgoing>Flow_w17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Merge">
      <bpmn:incoming>Flow_w2</bpmn:incoming>
      <bpmn:incoming>Flow_w10</bpmn:incoming>
      <bpmn:incoming>Flow_w17</bpmn:incoming>
      <bpmn:outgoing>Flow_w3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Receive" name="Receive IFC, claim and inputs">
      <bpmn:incoming>Flow_w3</bpmn:incoming>
      <bpmn:outgoing>Flow_w4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Identify" name="Identify relevant rooms and their windows">
      <bpmn:incoming>Flow_w4</bpmn:incoming>
      <bpmn:outgoing>Flow_w5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Validate" name="Validate areas, units and correction inputs">
      <bpmn:incoming>Flow_w5</bpmn:incoming>
      <bpmn:outgoing>Flow_w6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Valid" name="Data valid?">
      <bpmn:incoming>Flow_w6</bpmn:incoming>
      <bpmn:outgoing>Flow_w7</bpmn:outgoing>
      <bpmn:outgoing>Flow_w8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Calc" name="Calculate ratios, margins and glazing deficits">
      <bpmn:incoming>Flow_w7</bpmn:incoming>
      <bpmn:outgoing>Flow_w11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_RankCompare" name="Rank rooms and compare window changes">
      <bpmn:incoming>Flow_w11</bpmn:incoming>
      <bpmn:outgoing>Flow_w12</bpmn:outgoing>
      <bpmn:property id="Property_03a4ig6" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_w1">
        <bpmn:sourceRef>DataObjectReference_Scenario</bpmn:sourceRef>
        <bpmn:targetRef>Property_03a4ig6</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="Task_ExportW" name="Export room table and storey summary">
      <bpmn:incoming>Flow_w12</bpmn:incoming>
      <bpmn:outgoing>Flow_w13</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_w2">
        <bpmn:targetRef>DataObjectReference_Results</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="Task_ReturnIssues" name="Return issues to model author">
      <bpmn:incoming>Flow_w8</bpmn:incoming>
      <bpmn:outgoing>Flow_w9</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_w1">
        <bpmn:targetRef>DataObjectReference_Issues</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="Task_Review" name="Review results with architect">
      <bpmn:incoming>Flow_w13</bpmn:incoming>
      <bpmn:outgoing>Flow_w14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Changes" name="Changes to&#10;model needed?">
      <bpmn:incoming>Flow_w14</bpmn:incoming>
      <bpmn:outgoing>Flow_w15</bpmn:outgoing>
      <bpmn:outgoing>Flow_w16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_W" name="End process">
      <bpmn:incoming>Flow_w15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObjectReference id="DataObjectReference_Issues" name="List of unresolved&#10;data issues" dataObjectRef="DataObject_DataObjectReference_Issues" />
    <bpmn:dataObject id="DataObject_DataObjectReference_Issues" />
    <bpmn:dataObjectReference id="DataObjectReference_Scenario" name="Window scenario&#10;(proposed change)" dataObjectRef="DataObject_DataObjectReference_Scenario" />
    <bpmn:dataObject id="DataObject_DataObjectReference_Scenario" />
    <bpmn:dataObjectReference id="DataObjectReference_Results" name="Room table and&#10;storey summary" dataObjectRef="DataObject_DataObjectReference_Results" />
    <bpmn:dataObject id="DataObject_DataObjectReference_Results" />
    <bpmn:sequenceFlow id="Flow_w1" sourceRef="StartEvent_W" targetRef="Task_Provide" />
    <bpmn:sequenceFlow id="Flow_w2" sourceRef="Task_Provide" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_w9" sourceRef="Task_ReturnIssues" targetRef="Task_CorrectData" />
    <bpmn:sequenceFlow id="Flow_w10" sourceRef="Task_CorrectData" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_w16" name="yes" sourceRef="Gateway_Changes" targetRef="Task_AssessChanges" />
    <bpmn:sequenceFlow id="Flow_w17" name="revised IFC model, repeat checks" sourceRef="Task_AssessChanges" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_w3" sourceRef="Gateway_Merge" targetRef="Task_Receive" />
    <bpmn:sequenceFlow id="Flow_w4" sourceRef="Task_Receive" targetRef="Task_Identify" />
    <bpmn:sequenceFlow id="Flow_w5" sourceRef="Task_Identify" targetRef="Task_Validate" />
    <bpmn:sequenceFlow id="Flow_w6" sourceRef="Task_Validate" targetRef="Gateway_Valid" />
    <bpmn:sequenceFlow id="Flow_w7" name="yes" sourceRef="Gateway_Valid" targetRef="Task_Calc" />
    <bpmn:sequenceFlow id="Flow_w8" name="no" sourceRef="Gateway_Valid" targetRef="Task_ReturnIssues" />
    <bpmn:sequenceFlow id="Flow_w11" sourceRef="Task_Calc" targetRef="Task_RankCompare" />
    <bpmn:sequenceFlow id="Flow_w12" sourceRef="Task_RankCompare" targetRef="Task_ExportW" />
    <bpmn:sequenceFlow id="Flow_w13" sourceRef="Task_ExportW" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="Flow_w14" sourceRef="Task_Review" targetRef="Gateway_Changes" />
    <bpmn:sequenceFlow id="Flow_w15" name="no" sourceRef="Gateway_Changes" targetRef="EndEvent_W" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Workflow">
    <bpmndi:BPMNPlane id="BPMNDiagram_Workflow_plane" bpmnElement="Collaboration_Workflow">
      <bpmndi:BPMNShape id="Participant_Workflow_di" bpmnElement="Participant_Workflow" isHorizontal="true">
