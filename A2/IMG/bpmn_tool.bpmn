<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.0">
  <bpmn:category id="Category_Group_PerRoom">
    <bpmn:categoryValue id="CategoryValue_Group_PerRoom" value="For each relevant room" />
  </bpmn:category>
  <bpmn:collaboration id="Collaboration_Tool">
    <bpmn:participant id="Participant_Pref" name="PREFERENCE INFO" processRef="Process_Pref" />
    <bpmn:participant id="Participant_Tool" name="TOOL PROCESS" processRef="Process_Tool" />
    <bpmn:participant id="Participant_Info" name="INFO EXCHANGE" processRef="Process_Info" />
    <bpmn:messageFlow id="MessageFlow_Issues" sourceRef="Task_LogIssue" targetRef="Event_ReturnIssues" />
    <bpmn:group id="Group_PerRoom" categoryValueRef="CategoryValue_Group_PerRoom" />
    <bpmn:group id="Group_Outputs" categoryValueRef="CategoryValue_0jhj2id" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Pref" isExecutable="false">
    <bpmn:dataObjectReference id="DataObjectReference_RoomUse" name="Room use and&#10;assumptions&#10;(confirmed by&#10;architect)" dataObjectRef="DataObject_DataObjectReference_RoomUse" />
    <bpmn:dataObject id="DataObject_DataObjectReference_RoomUse" />
    <bpmn:dataObjectReference id="DataObjectReference_Corrections" name="Correction inputs&#10;(transmittance,&#10;shading, etc.)" dataObjectRef="DataObject_DataObjectReference_Corrections" />
    <bpmn:dataObject id="DataObject_DataObjectReference_Corrections" />
    <bpmn:dataObjectReference id="DataObjectReference_Validation" name="Validation checks:&#10;areas, units,&#10;corrections,&#10;window links" dataObjectRef="DataObject_DataObjectReference_Validation" />
    <bpmn:dataObject id="DataObject_DataObjectReference_Validation" />
    <bpmn:dataObjectReference id="DataObjectReference_BR18" name="BR18 §379&#10;10% method&#10;and guidance" dataObjectRef="DataObject_DataObjectReference_BR18" />
    <bpmn:dataObject id="DataObject_DataObjectReference_BR18" />
    <bpmn:dataObjectReference id="DataObjectReference_Scenario" name="Window scenario&#10;(proposed change,&#10;user input)" dataObjectRef="DataObject_DataObjectReference_Scenario" />
    <bpmn:dataObject id="DataObject_DataObjectReference_Scenario" />
    <bpmn:dataObjectReference id="DataObjectReference_Reporting" name="Reporting rules:&#10;preliminary label,&#10;surpluses do not&#10;offset deficits" dataObjectRef="DataObject_DataObjectReference_Reporting" />
    <bpmn:dataObject id="DataObject_DataObjectReference_Reporting" />
  </bpmn:process>
  <bpmn:process id="Process_Tool" isExecutable="false">
    <bpmn:laneSet id="LaneSet_0c3x2t8" />
    <bpmn:startEvent id="StartEvent_Tool" name="Start process">
      <bpmn:outgoing>Flow_t1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="EndEvent_Tool" name="End process">
      <bpmn:incoming>Flow_t17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_OpenIFC" name="Open IFC and read units">
      <bpmn:incoming>Flow_t1</bpmn:incoming>
      <bpmn:outgoing>Flow_t2</bpmn:outgoing>
      <bpmn:property id="Property_0ledian" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_t6">
        <bpmn:sourceRef>DataObjectReference_IFC</bpmn:sourceRef>
        <bpmn:targetRef>Property_0ledian</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="Task_ExtractRooms" name="Extract rooms (GUID, storey, name, use)">
      <bpmn:incoming>Flow_t2</bpmn:incoming>
      <bpmn:outgoing>Flow_t3</bpmn:outgoing>
      <bpmn:property id="Property_0it6qub" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_t1">
        <bpmn:sourceRef>DataObjectReference_RoomUse</bpmn:sourceRef>
        <bpmn:targetRef>Property_0it6qub</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="Task_ReadFloorArea" name="Read relevant floor area">
      <bpmn:categoryValueRef>CategoryValue_Group_PerRoom</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_t3</bpmn:incoming>
      <bpmn:outgoing>Flow_t4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AssociateWindows" name="Associate windows to rooms">
      <bpmn:categoryValueRef>CategoryValue_Group_PerRoom</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_t4</bpmn:incoming>
      <bpmn:outgoing>Flow_t5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_GlassArea" name="Determine corrected glass area">
      <bpmn:categoryValueRef>CategoryValue_Group_PerRoom</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_t5</bpmn:incoming>
      <bpmn:outgoing>Flow_t6</bpmn:outgoing>
      <bpmn:property id="Property_0j2vsco" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_t2">
        <bpmn:sourceRef>DataObjectReference_Corrections</bpmn:sourceRef>
        <bpmn:targetRef>Property_0j2vsco</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_DataValid" name="Room data&#10;valid?">
      <bpmn:categoryValueRef>CategoryValue_Group_PerRoom</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_t6</bpmn:incoming>
      <bpmn:outgoing>Flow_t7</bpmn:outgoing>
      <bpmn:outgoing>Flow_t8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Calculate" name="Calculate ratio, margins and glazing deficit">
      <bpmn:categoryValueRef>CategoryValue_Group_PerRoom</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_t7</bpmn:incoming>
      <bpmn:outgoing>Flow_t9</bpmn:outgoing>
      <bpmn:property id="Property_1ram3z2" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_t3">
        <bpmn:sourceRef>DataObjectReference_BR18</bpmn:sourceRef>
        <bpmn:targetRef>Property_1ram3z2</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="Task_Rank" name="Rank rooms below 10% by glazing deficit">
      <bpmn:incoming>Flow_t9</bpmn:incoming>
      <bpmn:incoming>Flow_t10</bpmn:incoming>
      <bpmn:outgoing>Flow_t11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Scenario" name="Scenario&#10;entered?">
      <bpmn:incoming>Flow_t11</bpmn:incoming>
      <bpmn:outgoing>Flow_t12</bpmn:outgoing>
      <bpmn:outgoing>Flow_t15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_StoreySummary" name="Compile storey summary">
      <bpmn:incoming>Flow_t14</bpmn:incoming>
      <bpmn:incoming>Flow_t15</bpmn:incoming>
      <bpmn:outgoing>Flow_t16</bpmn:outgoing>
      <bpmn:property id="Property_0yo8w1s" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_t5">
        <bpmn:sourceRef>DataObjectReference_Reporting</bpmn:sourceRef>
        <bpmn:targetRef>Property_0yo8w1s</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="Task_Export" name="Export room table, summary and scenarios">
      <bpmn:incoming>Flow_t16</bpmn:incoming>
      <bpmn:outgoing>Flow_t17</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_t2">
        <bpmn:targetRef>DataObjectReference_RoomTable</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_t3">
        <bpmn:targetRef>DataObjectReference_StoreySummary</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_t4">
        <bpmn:targetRef>DataObjectReference_ScenarioComp</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="Task_LogIssue" name="Log issue and mark room unassessable">
      <bpmn:categoryValueRef>CategoryValue_Group_PerRoom</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_t8</bpmn:incoming>
      <bpmn:outgoing>Flow_t10</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_t1">
        <bpmn:targetRef>DataObjectReference_Issues</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="Task_Recalc" name="Recalculate with proposed window (IFC unchanged)">
      <bpmn:incoming>Flow_t12</bpmn:incoming>
      <bpmn:outgoing>Flow_t13</bpmn:outgoing>
      <bpmn:property id="Property_1rbnw97" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_t4">
        <bpmn:sourceRef>DataObjectReference_Scenario</bpmn:sourceRef>
        <bpmn:targetRef>Property_1rbnw97</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="Task_Compare" name="Compare revised result with baseline">
      <bpmn:incoming>Flow_t13</bpmn:incoming>
      <bpmn:outgoing>Flow_t14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_t1" sourceRef="StartEvent_Tool" targetRef="Task_OpenIFC" />
    <bpmn:sequenceFlow id="Flow_t17" sourceRef="Task_Export" targetRef="EndEvent_Tool" />
    <bpmn:sequenceFlow id="Flow_t2" sourceRef="Task_OpenIFC" targetRef="Task_ExtractRooms" />
    <bpmn:sequenceFlow id="Flow_t3" sourceRef="Task_ExtractRooms" targetRef="Task_ReadFloorArea" />
    <bpmn:sequenceFlow id="Flow_t4" sourceRef="Task_ReadFloorArea" targetRef="Task_AssociateWindows">
