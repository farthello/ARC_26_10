    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_t5" sourceRef="Task_AssociateWindows" targetRef="Task_GlassArea">
      <bpmn:categoryValueRef>CategoryValue_Group_PerRoom</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_t6" sourceRef="Task_GlassArea" targetRef="Gateway_DataValid">
      <bpmn:categoryValueRef>CategoryValue_Group_PerRoom</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_t7" name="yes" sourceRef="Gateway_DataValid" targetRef="Task_Calculate">
      <bpmn:categoryValueRef>CategoryValue_Group_PerRoom</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_t8" name="no" sourceRef="Gateway_DataValid" targetRef="Task_LogIssue">
      <bpmn:categoryValueRef>CategoryValue_Group_PerRoom</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_t9" sourceRef="Task_Calculate" targetRef="Task_Rank" />
    <bpmn:sequenceFlow id="Flow_t10" sourceRef="Task_LogIssue" targetRef="Task_Rank" />
    <bpmn:sequenceFlow id="Flow_t11" sourceRef="Task_Rank" targetRef="Gateway_Scenario" />
    <bpmn:sequenceFlow id="Flow_t12" name="yes" sourceRef="Gateway_Scenario" targetRef="Task_Recalc" />
    <bpmn:sequenceFlow id="Flow_t15" name="no" sourceRef="Gateway_Scenario" targetRef="Task_StoreySummary" />
    <bpmn:sequenceFlow id="Flow_t14" sourceRef="Task_Compare" targetRef="Task_StoreySummary" />
    <bpmn:sequenceFlow id="Flow_t16" sourceRef="Task_StoreySummary" targetRef="Task_Export" />
    <bpmn:sequenceFlow id="Flow_t13" sourceRef="Task_Recalc" targetRef="Task_Compare" />
    <bpmn:association id="Association_Validation" associationDirection="One" sourceRef="DataObjectReference_Validation" targetRef="Gateway_DataValid" />
  </bpmn:process>
